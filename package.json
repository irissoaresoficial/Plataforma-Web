{
  "name": "iris",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "dev:plataforma": "npm run dev -w plataforma",
    "build": "npm run build -w web && npm run build -w plataforma",
    "build:web": "npm run build -w web",
    "build:plataforma": "npm run build -w plataforma",
    "tipos": "npm run tipos -w web && npm run tipos -w plataforma"
  },
  "engines": {
    "node": ">=20"
  }
}
