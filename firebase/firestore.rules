rules_version = '2';

/**
 * QUIÉN PUEDE TOCAR QUÉ.
 *
 * Estas reglas se pegan en la consola de Firebase: Firestore Database →
 * pestaña «Reglas» → Publicar. Sin ellas, Firestore o bien está abierto de par
 * en par (modo prueba) o bien cerrado del todo, y ninguna de las dos cosas
 * sirve.
 *
 * LA IDEA, EN UNA FRASE: la web ESCRIBE por detrás y la plataforma LEE por
 * delante, y estas reglas sólo mandan sobre la segunda.
 *
 * Es importante entender por qué. La web guarda los leads desde su servidor con
 * el SDK de administrador, y ese SDK NO PASA POR AQUÍ: tiene permiso de dueño
 * por definición. Así que nada de lo que se escriba en este archivo puede
 * romper la captación de correos, y no hace falta abrir ni un hueco para que la
 * web funcione. Estas reglas existen sólo para lo que se hace desde un
 * navegador — es decir, la plataforma de Iris.
 *
 * Y de ahí sale la regla de oro: TODO CERRADO, y se abre sólo lo justo.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------------------------------------------------------- */
    /*  Quién eres                                                       */
    /* ---------------------------------------------------------------- */

    /**
     * Estar dentro no es tener una cuenta: es tener una FICHA en `usuarios` con
     * la cuenta activa. Son dos cosas distintas a propósito.
     *
     * Si bastara con tener cuenta en Firebase Auth, quitarle el acceso a
     * alguien obligaría a borrarle la cuenta entera —y con ella el rastro de lo
     * que hizo—. Con la ficha aparte, se le pone `activo: false` y esa persona
     * deja de entrar al instante sin que se pierda nada.
     */
    function ficha() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function dentro() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && ficha().activo == true;
    }
    /*
     * LOS ROLES, QUE ANTES NO HACÍAN FALTA Y AHORA SÍ.
     *
     * Aquí ponía «NO HAY ROLES», y el motivo era bueno: con una sola usuaria,
     * un permiso que nadie comprueba nunca es ruido. Decía también que el día
     * que entrara alguien con permisos distintos se añadirían «sabiendo qué
     * hace falta de verdad».
     *
     * Ese día es hoy: la escuela abre con cursos, y entran alumnos y miembros.
     * Lo que NO pueden ver es exactamente lo que Iris usa para trabajar: el
     * despacho —clientas, leads, agenda, facturas— y la lectura de Kábala. Un
     * alumno paga un curso; no compra el método.
     *
     * LAS FICHAS SIN `roles` SON ADMINISTRADORAS. Todas las que existen hoy se
     * escribieron antes de que esto existiera, y todas tienen acceso completo
     * ahora mismo. Si al publicar estas reglas se las tratara como al rol más
     * bajo «por prudencia», Iris se quedaría fuera de su propia plataforma y no
     * quedaría nadie dentro capaz de devolverle el acceso.
     *
     * ESTO TIENE QUE DECIR LO MISMO QUE `lib/roles.ts`. Son dos sitios porque
     * las reglas corren en el servidor de Google y el código en el navegador,
     * y no hay manera de compartirlos. El de aquí es el que manda: el del
     * navegador sólo sirve para enseñar la pantalla correcta.
     */
    function roles() {
      return ficha().get('roles', ['admin']);
    }
    function esAdmin() {
      return dentro() && ('admin' in roles() || roles().size() == 0);
    }
    /* Quien monta cursos propios. Lo mismo que `lib/roles.ts`. */
    function esCreador() {
      return dentro() && 'creador' in roles();
    }

    /**
     * EL ARRANQUE: CÓMO ENTRA LA PRIMERA PERSONA.
     *
     * Sin esto hay un problema de huevo y gallina sin salida: `dentro()` exige
     * tener ficha, y crear una ficha exige estar dentro. La primera persona no
     * podría entrar nunca, y la única forma de desatascarlo sería ir a la
     * consola de Firebase a crear el documento a mano — copiando un
     * identificador de veintiocho caracteres y escribiendo cuatro campos, que
     * es donde más gente se equivoca de toda la instalación.
     *
     * Así que se abre un solo agujero, del tamaño exacto de una persona:
     *
     *   · sólo el correo de la dueña, escrito aquí entero;
     *   · sólo para SU PROPIA ficha, nunca para la de otro;
     *   · sólo si no existe ya — `create` no puede pisar un documento que está,
     *     así que esto deja de funcionar en cuanto se usa una vez;
     *   · y sólo con el correo verificado por Firebase Auth, que es un dato del
     *     vale firmado y no algo que el navegador pueda inventarse.
     *
     * Para aprovecharlo haría falta controlar ese Gmail. Quien controle ese
     * Gmail ya es la dueña.
     *
     * EL CORREO VA ESCRITO AQUÍ Y TAMBIÉN EN `lib/firebase.ts`, y los dos tienen
     * que decir exactamente lo mismo. Las reglas no pueden leer variables de
     * entorno, así que no hay manera de tenerlo en un solo sitio; lo que sí hay
     * es que si un día discreparan, la plataforma diría que sí y el servidor que
     * no, y el mensaje que vería la persona no explicaría nada.
     */
    function arranque(uid) {
      return request.auth != null
        && uid == request.auth.uid
        && request.auth.token.email.lower() == 'irissoaresoficial@gmail.com'
        && request.resource.data.activo == true;
    }

    /* ---------------------------------------------------------------- */
    /*  Los usuarios de la plataforma                                    */
    /* ---------------------------------------------------------------- */

    match /usuarios/{uid} {
      /* Cualquiera que esté dentro ve la lista: hace falta para saber quién ha
         apuntado una nota, y para que la pantalla de accesos tenga algo que
         enseñar.
         ----------------------------------------------------------------
         Y CUALQUIERA PUEDE LEER LA SUYA. Esta segunda mitad no es un capricho:
         sin ella el arranque de más abajo es inalcanzable y NO ENTRA NADIE NUNCA.

         La secuencia real, que costó una tarde: la dueña escribe su contraseña,
         Firebase Auth la acepta, la plataforma va a leer su ficha para saber si
         tiene permiso… y ESTA LÍNEA se lo niega, porque `dentro()` exige tener
         ficha y ella todavía no la tiene. La lectura falla, el código la echa, y
         la pantalla vuelve a la puerta como si la contraseña estuviera mal. El
         `allow create` de abajo estaba bien escrito y no se ejecutaba jamás.

         Leer TU PROPIA ficha no enseña nada de nadie: o dice que estás activo o
         dice que no, y las dos cosas las sabes ya por lo que tienes delante. Lo
         que abre es exactamente el paso que faltaba, ni un milímetro más. */
      /* LA LISTA ENTERA, SÓLO LA ADMINISTRACIÓN. Antes la veía cualquiera que
         estuviera dentro, y mientras «dentro» significaba Iris eso era igual
         de seguro y más simple. Con alumnos dentro deja de serlo: la lista de
         `usuarios` son nombres y correos de todas las personas de la escuela,
         y enseñárselos a quien compró un curso es una cesión de datos que
         nadie ha consentido. */
      allow read: if esAdmin() || (request.auth != null && uid == request.auth.uid);

      /**
       * Dar y quitar accesos lo hace quien está dentro, con un candado: NADIE
       * PUEDE DEJARSE A SÍ MISMO FUERA.
       *
       * No es una precaución teórica. Si Iris se desactiva por error, la
       * plataforma se queda sin una sola persona capaz de volver a activarla, y
       * eso ya no se arregla desde aquí: hay que entrar a mano en la consola de
       * Firebase. Con una sola cuenta viva, ese error es irreversible desde
       * dentro.
       */
      /* Dar, quitar y cambiar accesos es cosa de la administración. Y el
         candado de siempre: nadie puede dejarse a sí mismo fuera, ni quitarse
         su propia administración. Si Iris lo hiciera por error, no quedaría
         nadie capaz de devolvérselo sin entrar a mano en la consola. */
      allow create: if esAdmin() || arranque(uid);
      allow update: if (esAdmin()
        && (uid != request.auth.uid
            || (request.resource.data.activo == true
                && 'admin' in request.resource.data.get('roles', ['admin'])))
        )
        /*
         * O TÚ, PERO SÓLO TU NOMBRE.
         *
         * El artículo 16 del reglamento europeo es el derecho a que te
         * corrijan un dato equivocado, y tener que escribirle a Iris para que
         * te arregle una letra no es ejercerlo: es pedir un favor.
         *
         * `affectedKeys().hasOnly(['nombre'])` es lo que hace que esto sea
         * seguro, y conviene entender por qué es tan estrecho. Sin eso, la
         * misma puerta que deja corregir «Rakel» por «Raquel» deja escribir
         * `roles: ['admin']` — porque desde el navegador no se manda «cambia
         * el nombre», se manda un documento entero, y el documento entero lo
         * escribe quien quiera lo que quiera. La regla no mira lo que la
         * pantalla pretendía hacer; mira QUÉ CAMPOS han cambiado. Si ha
         * cambiado alguno que no sea `nombre`, no pasa.
         *
         * Lo que queda fuera, dicho: el rol (quién eres), `activo` (si
         * entras) y el correo (con el que entras). Los tres son de la
         * administración, y los tres serían una forma de colarse.
         */
        || (request.auth != null
            && uid == request.auth.uid
            /* Y su foto, desde el 20 de octubre de 2026: la dirección de la
               imagen que subió a `avatares/<su uid>/`, nada más. */
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'foto'])
            && request.resource.data.nombre is string
            && request.resource.data.nombre.size() > 0
            && request.resource.data.nombre.size() <= 80
            && (!('foto' in request.resource.data)
                || (request.resource.data.foto is string && request.resource.data.foto.size() <= 2000)));
      allow delete: if esAdmin() && uid != request.auth.uid;
    }

    /* ---------------------------------------------------------------- */
    /*  Los leads que entran por la web                                  */
    /* ---------------------------------------------------------------- */

    match /leads/{id} {
      /* Se leen desde la plataforma y se pueden mover de estado —nuevo,
         contactado, cliente— y anotar. */
      allow read: if esAdmin();
      allow update: if esAdmin();

      /**
       * CREAR, NO. Y esto no es una omisión.
       *
       * Un lead sólo puede nacer de que una persona real haya rellenado un
       * formulario en la web, y eso lo escribe el servidor. Si desde el
       * navegador se pudieran crear, la lista de Iris dejaría de ser un registro
       * de lo que ha pasado para pasar a ser una lista donde cabe cualquier
       * cosa.
       */
      allow create: if false;

      /**
       * BORRAR, SÍ. Y ANTES DECÍA QUE NO — ME EQUIVOQUÉ.
       *
       * El argumento era: «un correo que llegó, llegó; si sobra se marca como
       * descartado y así queda el rastro de que estuvo». Suena bien y es la
       * regla correcta para un lead de verdad.
       *
       * El problema es que no contempla el caso más frecuente de todos, que es
       * el que estaba pasando mientras se escribía esa regla: las PRUEBAS. Al
       * montar esto se hacen diez reservas de mentira con el propio correo, y
       * todas caen aquí para siempre. «Descartado» no vale para eso: descartado
       * significa «esta persona no me interesa», y una prueba no es una persona.
       * Queda una columna con basura que no se puede limpiar, y una lista que no
       * se puede limpiar se deja de mirar.
       *
       * Y hay algo peor que la basura: el derecho de supresión. Si alguien
       * escribe pidiendo que borren sus datos, hay veinte días para hacerlo. Con
       * esta regla en `false` la única forma era entrar a mano en la consola de
       * Firebase. Una plataforma que obliga a eso para cumplir la ley está mal
       * hecha.
       *
       * Se borra desde la ficha y con confirmación, que es donde vive el resto
       * de lo irreversible.
       */
      allow delete: if esAdmin();
    }

    match /reservas/{id} {
      allow read, update: if esAdmin();
      allow create, delete: if false;
    }

    /* ---------------------------------------------------------------- */
    /*  El despacho: agenda, clientes y facturas                         */
    /* ---------------------------------------------------------------- */

    /**
     * Esto sí lo escribe Iris desde la plataforma, así que aquí sí se abre.
     * Pero las facturas emitidas no se borran nunca: una factura con número
     * asignado forma parte de una serie correlativa y hacerla desaparecer deja
     * un hueco. Se anula —un `update`— y conserva su número.
     */
    match /citas/{id}    { allow read, write: if esAdmin(); }
    match /clientes/{id} { allow read, write: if esAdmin(); }
    match /facturas/{id} {
      allow read, create, update: if esAdmin();
      allow delete: if esAdmin() && resource.data.numero == null;
    }
    match /avisos/{id}   { allow read, write: if esAdmin(); }

    /* Los ajustes de la casa: hoy, los datos fiscales de quien factura. Se
       escriben desde la pantalla y no desde el código, así que necesitan regla
       — y sólo la necesita quien ya está dentro. */
    match /ajustes/{id}  { allow read, write: if esAdmin(); }

    /* ---------------------------------------------------------------- */
    /*  LA ESCUELA                                                       */
    /* ---------------------------------------------------------------- */

    /*
     * AQUÍ ENTRA GENTE QUE NO ES IRIS, y ésa es toda la diferencia con lo de
     * arriba. Todo lo anterior es de una sola persona y la regla es «¿eres
     * ella?». A partir de aquí la pregunta es otra: «¿esto es tuyo?».
     *
     * Y esto es lo único que de verdad protege nada. La plataforma esconde del
     * menú lo que no se puede abrir y redirige a quien escribe una dirección a
     * mano, pero eso corre en el navegador de cada uno y se salta desde la
     * consola en diez segundos. Lo de aquí corre en el servidor de Google y no
     * se salta.
     */

    /*
     * LOS CURSOS.
     *
     * Dos lectores distintos y por eso dos condiciones:
     *
     *   · Iris lo ve todo, borradores incluidos — los necesita para montarlos.
     *   · Cualquiera que haya entrado ve los PUBLICADOS. Ojo a lo que esto NO
     *     dice: no dice que pueda verlos sólo quien lo ha comprado. Un curso
     *     publicado es un escaparate —su título, de qué va, su portada— y hace
     *     falta poder enseñárselo a alguien para que decida comprarlo.
     *
     * LO QUE SE COMPRA ES EL CONTENIDO, Y ESO NO ESTÁ AQUÍ. Los enlaces de los
     * vídeos viven dentro de este mismo documento, así que a día de hoy quien
     * vea el curso ve los enlaces. ESTO HAY QUE PARTIRLO ANTES DE COBRAR: el
     * escaparate por un lado y las lecciones por otro, y las lecciones sólo
     * para quien tenga inscripción. Está escrito aquí porque es el sitio donde
     * se va a mirar el día que se monte el pago, y porque un «ya lo haremos»
     * que no está escrito en ninguna parte no se hace nunca.
     *
     * Escribir: Iris, y cada creador lo suyo (abajo). Y `publicados()` filtra en el servidor por eso
     * mismo: si un alumno pidiera todos los cursos, Firestore rechaza la
     * consulta entera en vez de devolverle los que sí puede ver.
     */
    /*
     * Y DESDE EL 20 DE OCTUBRE DE 2026, LOS CREADORES. Cuatro candados:
     *
     *   1. Leen SUS cursos —borradores incluidos— por el campo `autor`. Los
     *      de otro creador, sólo si están publicados, como cualquiera.
     *   2. Crean un curso sólo a su nombre y en borrador.
     *   3. Al editar no pueden cambiar ni el autor ni `publicado`: no se
     *      quitan la autoría para pasársela a otro, y no publican. Publicar
     *      es de Iris; el creador marca `revision` y ella decide.
     *   4. Borran sólo lo suyo y sólo en borrador. Un curso publicado tiene
     *      alumnos dentro, y borrarlo es de Iris.
     */
    /*
     * Y DESDE EL 21 DE OCTUBRE, EL EQUIPO. Un curso puede llevarlo más de un
     * creador (Desórdenes Amorosos: Gerson y Marco, con Iris). Los del campo
     * `equipo` leen y editan el curso como su autor, con los mismos candados,
     * y uno más: nadie de fuera de Iris toca el equipo, ni para meterse ni
     * para sacar a otro. Borrar sigue siendo sólo del autor.
     */
    function loLleva(datos) {
      return datos.get('autor', '') == request.auth.uid
        || request.auth.uid in datos.get('equipo', []);
    }

    match /cursos/{id} {
      allow read: if esAdmin()
        || (dentro() && resource.data.publicado == true)
        || (esCreador() && loLleva(resource.data));
      allow create: if esAdmin()
        || (esCreador()
            && request.resource.data.get('autor', '') == request.auth.uid
            && request.resource.data.publicado == false
            && request.resource.data.get('equipo', []).size() == 0);
      allow update: if esAdmin()
        || (esCreador()
            && loLleva(resource.data)
            && request.resource.data.get('autor', '') == resource.data.get('autor', '')
            && request.resource.data.get('equipo', []) == resource.data.get('equipo', [])
            && request.resource.data.get('equipoNombres', {}) == resource.data.get('equipoNombres', {})
            && request.resource.data.publicado == resource.data.publicado);
      allow delete: if esAdmin()
        || (esCreador()
            && resource.data.get('autor', '') == request.auth.uid
            && resource.data.publicado == false);
    }

    /*
     * LAS INSCRIPCIONES: quién tiene acceso a qué.
     *
     * Cada uno ve LAS SUYAS y nada más. Esto no es pudor: la lista entera dice
     * quién ha comprado qué y cuándo, que es la contabilidad de la escuela.
     *
     * Y NADIE SE INSCRIBE A SÍ MISMO. Es la regla que sostiene todo el dinero
     * del negocio: si un alumno pudiera escribir aquí, se daría acceso a todos
     * los cursos sin pagar uno. Las escribe Iris a mano hoy, y el día que haya
     * Stripe las escribirá el servidor con las llaves de administración, que no
     * pasan por estas reglas.
     *
     * Por eso el identificador es `uid__cursoId` y se comprueba que el `uid` de
     * dentro coincide con el de quien lee: sin eso, bastaría con adivinar el
     * identificador de otro para leer su inscripción.
     */
    match /inscripciones/{id} {
      /* Y el creador, las de SUS cursos: el autor va copiado en la propia
         inscripción al darla, para poder preguntarlo así. */
      allow read: if esAdmin()
        || (dentro() && resource.data.uid == request.auth.uid)
        || (esCreador() && loLleva(resource.data));
      allow write: if esAdmin();
    }

    /*
     * EL AVANCE: por dónde va cada uno.
     *
     * Esto sí lo escribe la propia persona —marcar una lección como terminada
     * es ella pulsando un botón— pero SÓLO EL SUYO. Sin la comprobación del
     * `uid`, cualquiera podría escribir el avance de otro, que además de ser
     * una tontería sería la vía para destrozarle las rachas y los trofeos a
     * alguien.
     *
     * Se comprueba `request.resource.data.uid` y no `resource.data.uid`:
     * `resource` es lo que YA hay y al crear el documento todavía no hay nada.
     * Con `resource` la primera lección terminada de cada curso fallaría, y
     * sería de esos fallos que sólo pasan la primera vez y no se reproducen al
     * ir a mirarlos.
     *
     * Y ESO ES EXACTAMENTE LO QUE PASABA AL LEER. La trampa estaba avisada
     * aquí arriba para escribir, se esquivó para escribir, y la línea de leer
     * se quedó con ella dentro: `resource.data.uid` sobre un documento que
     * todavía no existe no es false, es un error de evaluación, y un error de
     * evaluación es un no.
     *
     * Consecuencia, encontrada probando con una cuenta de alumna de verdad el
     * 16 de octubre de 2026: la PRIMERA lección de CADA curso no se podía
     * marcar nunca. La pantalla leía el avance antes de escribirlo, esa lectura
     * recibía un no, y el botón «Marcar como terminada» se quedaba quieto sin
     * decir nada. No fallaba una vez de cada cien: fallaba siempre, y en
     * silencio, porque el único sitio donde se veía era la consola del
     * navegador.
     *
     * Así que al leer hay dos casos y se dicen los dos:
     *
     *   · El documento existe   → es tuyo si su `uid` es el tuyo.
     *   · El documento no existe → es tuyo si su NOMBRE empieza por tu `uid`,
     *     porque el nombre es `uid__cursoId` y lo pone el código, no la
     *     persona.
     *
     * El segundo caso podría escribirse simplemente «si no existe, pasa»: no
     * hay nada dentro que llevarse. Pero sí se llevaría algo: saber que NO
     * existe. Con la lista de alumnas delante, cualquiera podría preguntar
     * documento a documento quién ha empezado qué curso y quién no. Cuesta una
     * línea no regalarlo.
     */
    match /avance/{id} {
      /* El creador lee el avance de la gente en SUS cursos —para sus
         métricas—, por el autor que se copia al marcar una lección. */
      allow read: if esAdmin() || (dentro() && (
        resource == null
          ? id.split('__')[0] == request.auth.uid
          : resource.data.uid == request.auth.uid
      )) || (esCreador() && resource != null && loLleva(resource.data));
      /*
       * ESCRIBIR Y BORRAR SE DICEN APARTE, y no por gusto de partir reglas.
       *
       * `allow write` es las tres cosas a la vez —crear, cambiar y borrar— y
       * al borrar NO HAY `request.resource`: se está mandando quitar, no
       * poner. Preguntarle su `uid` es la misma trampa que había dos párrafos
       * más arriba, con el error en el otro extremo: aquí `resource` sí
       * existe y es `request.resource` el que está vacío.
       *
       * Importa porque borrar el avance propio es parte de darse de baja (el
       * artículo 17 del reglamento europeo), y con `write` a secas la baja
       * dejaba el avance dentro para siempre.
       */
      allow create: if dentro() && request.resource.data.uid == request.auth.uid;
      /* Iris también cambia el avance de otros, y sólo para una cosa: copiar
         en él el equipo del curso cuando lo cambia (ver `cambiaEquipo`). */
      allow update: if esAdmin() || (dentro() && request.resource.data.uid == request.auth.uid);
      allow delete: if esAdmin() || (dentro() && resource.data.uid == request.auth.uid);
    }

    /*
     * LA COMUNIDAD.
     *
     * Aquí la gente escribe, y eso cambia la forma de las reglas: hasta ahora
     * casi todo lo escribía Iris. Un sitio donde escriben veinte personas pide
     * dos candados que no hacían falta antes.
     *
     * CANDADO 1: NADIE FIRMA CON EL NOMBRE DE OTRO. Se comprueba que el `uid`
     * de dentro del mensaje es el de quien lo está escribiendo. Sin esto,
     * cualquiera puede publicar un tema firmado por Iris — y en una escuela
     * donde lo que ella dice va a misa, eso no es una travesura.
     *
     * Por el mismo motivo se comprueba `esIris`: esa bandera es la que pinta la
     * etiqueta «la escuela» al lado del nombre, así que ponérsela a sí mismo
     * sería ponerse el uniforme. Sólo puede ir en true si de verdad lo es.
     *
     * CANDADO 2: LO QUE SE ESCRIBE NO SE REESCRIBE A GUSTO. Un autor puede
     * corregir su propio texto, pero no puede cambiar de quién es el mensaje
     * ni cuándo se escribió. Y `fijado` sólo lo toca Iris: es el sitio donde
     * ella dice lo que todos tienen que leer, y si cualquiera pudiera fijarse
     * a sí mismo, el sitio deja de servir para eso en una semana.
     *
     * LEER, cualquiera que esté dentro. Una comunidad que sólo ven algunos no
     * es una comunidad; y el control de quién entra en la escuela ya está
     * hecho en `dentro()`.
     *
     * BORRAR: el autor lo suyo, Iris lo que sea. Ella tiene que poder quitar
     * algo que no toque sin pedirle permiso a quien lo escribió.
     */
    match /temas/{id} {
      allow read: if dentro();
      allow create: if dentro()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.esIris == esAdmin()
        && request.resource.data.fijado == false
        && request.resource.data.respuestas == 0;
      allow update: if esAdmin()
        || (dentro()
            && resource.data.uid == request.auth.uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.creado == resource.data.creado
            && request.resource.data.fijado == resource.data.fijado);
      allow delete: if esAdmin() || (dentro() && resource.data.uid == request.auth.uid);
    }

    /*
     * LAS RESPUESTAS. Mismos dos candados.
     *
     * Y una cosa que NO se puede comprobar desde aquí, dicha para que nadie la
     * dé por hecha: que el contador de respuestas del tema cuadre con las que
     * hay de verdad. Son dos escrituras distintas y las reglas miran una cada
     * vez. Si la segunda falla, el número se queda corto. Se asume a sabiendas
     * —un contador bajo no engaña a nadie de forma que importe— y por eso el
     * contador no se usa para nada que decida nada.
     */
    match /respuestas/{id} {
      allow read: if dentro();
      allow create: if dentro()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.esIris == esAdmin();
      allow update: if dentro()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.creado == resource.data.creado;
      allow delete: if esAdmin() || (dentro() && resource.data.uid == request.auth.uid);
    }

    /*
     * LA BIBLIOTECA, QUE YA NO EXISTE COMO TAL.
     *
     * Había aquí una colección `recursos` con todos los archivos juntos, y
     * una pantalla en el menú para verlos. Gerson la deshizo: «cada curso
     * tiene sus recursos, entonces es irrelevante colocarlo allí».
     *
     * Ahora la ficha de cada archivo vive DENTRO del documento de su curso,
     * al lado de sus módulos, así que la manda la regla de `cursos` y no hace
     * falta ninguna aquí. El archivo en sí sigue en el almacén, bajo
     * `recursos/<curso>/`, y eso sí tiene su regla — en `storage.rules`, que
     * es un archivo distinto y es el error más común de esta instalación.
     *
     * NO SE DEJA LA REGLA VIEJA «POR SI ACASO». La colección quedó vacía
     * —comprobado antes de tocar nada— y una regla que autoriza a leer algo
     * que ya nadie escribe es una puerta abierta a un sitio del que nadie se
     * acuerda. El cierre general de más abajo la cubre.
     *
     * LO QUE ESTO HEREDA, dicho: quien puede leer un curso puede leer los
     * enlaces de sus archivos, igual que puede leer los enlaces de sus
     * vídeos. Es el mismo agujero que ya estaba anotado para los vídeos
     * —hoy el escaparate y el contenido viven en el mismo documento— y se
     * tapa de una vez cuando se parta ese documento, antes de cobrar.
     */

    /*
     * LAS VISITAS: qué días ha entrado cada uno.
     *
     * Un documento por persona, con la lista de días. Es lo único que alimenta
     * la racha, y la racha es lo que más engancha de toda la escuela.
     *
     * CADA UNO ESCRIBE EL SUYO Y SÓLO EL SUYO. Sin esa comprobación se le
     * podrían escribir días a otro: parece una tontería y no lo es — inflar
     * la racha de alguien, o romperla, es estropear lo único que le hacía
     * volver.
     *
     * Y SÓLO LO VE SU DUEÑO. Los días que alguien entra en una escuela de
     * desarrollo personal dibujan su vida: cuándo está mal, cuándo se fue de
     * viaje, cuándo dejó de venir. Iris sí los ve —los necesita para las
     * métricas— pero nadie más.
     */
    match /visitas/{uid} {
      allow read: if esAdmin() || (dentro() && uid == request.auth.uid);
      allow write: if dentro() && uid == request.auth.uid;
    }

    /*
     * LOS ESTUDIOS DE IRIS. Las cartas de Kábala y numerología que levanta en
     * la consulta, con lo que ella escribe encima de cada una.
     *
     * Hasta el 16 de octubre de 2026 esto no existía porque las cartas vivían
     * sólo en el navegador. Eso no era una decisión, era una bomba de relojería:
     * limpiar el historial, cambiar de ordenador o abrirlo en el móvil y no
     * hay nada. Ahora se guardan aquí.
     *
     * SÓLO IRIS, Y NO ES LO MISMO QUE «SÓLO QUIEN ESTÉ DENTRO». Aquí hay
     * nombres completos y fechas de nacimiento de SUS CLIENTES — datos de
     * terceros que ella custodia y que nadie le ha autorizado a enseñar a los
     * alumnos de la escuela. Un alumno que ha pagado un curso no tiene nada
     * que hacer en esta colección, y por eso la llave es `esAdmin()` y no
     * `dentro()`.
     *
     * Y por eso mismo esto es un sitio MEJOR que un portátil: en Firestore
     * está cifrado, en europe-west1 —dentro de la Unión Europea, que es lo
     * que pide el reglamento— y con copia. En un disco no está ninguna de las
     * tres cosas.
     */
    match /estudios/{id} { allow read, write: if esAdmin(); }

    /*
     * LO QUE CUESTA LA PUBLICIDAD: UN DOCUMENTO POR DÍA.
     *
     * Gerson, el 20 de octubre de 2026: quiere ver en la plataforma el gasto y
     * cuánta gente entra, «y estas métricas las debe ver también la otra
     * persona a la que le daremos acceso al panel de Desórdenes Amorosos».
     *
     * LEER: cualquiera que esté dentro. No hay nada personal aquí —son
     * importes, impresiones y clics de una campaña— y restringirlo a Iris
     * dejaría fuera justo a quien lleva el curso que la campaña anuncia. Un
     * alumno que llegue a verlo no se entera de nada que le importe.
     *
     * ESCRIBIR: NADIE. Ni Iris. Y es lo más importante de este bloque.
     *
     * Estos números no son una opinión: son lo que dijo Meta. Los escribe el
     * proceso diario con la llave de administración, que se salta estas reglas
     * por definición. Si además se pudieran teclear desde el navegador, el día
     * que alguien corrigiera un gasto «porque no le cuadraba» esta pantalla
     * dejaría de ser una medición para pasar a ser una creencia, y el coste por
     * persona apuntada —que es el número con el que se decide dónde va el
     * dinero— saldría de una cuenta con un lado inventado.
     *
     * El identificador del documento es la fecha, `2026-10-20`. Eso hace que
     * repetir el proceso un mismo día PISE el dato en vez de duplicarlo: si
     * falla y se reintenta, no quedan dos gastos del martes sumándose.
     */
    match /campana/{dia} {
      allow read: if dentro();
      allow write: if false;
    }

    /*
     * LA AGENDA DE CADA CREADOR. Suya y de nadie más: ni otro creador ni la
     * propia Iris —que tiene la suya en `citas`— la leen. Es su negocio.
     */
    match /agenda/{id} {
      allow read, update, delete: if esCreador() && resource.data.uid == request.auth.uid;
      allow create: if esCreador() && request.resource.data.uid == request.auth.uid;
    }

    /*
     * LAS BAJAS: «quiero que me borres».
     *
     * El artículo 17 del reglamento europeo, y la única colección de todo
     * esto que nace de que alguien quiera DEJAR la escuela. Por eso tiene una
     * forma distinta de todas las demás.
     *
     * CREAR, CUALQUIERA, PERO SÓLO LA SUYA. El nombre del documento es el uid
     * de quien la pide, así que no hay dos bajas de la misma persona y no hay
     * forma de pedir la baja de otra: el nombre tendría que ser el uid de esa
     * otra, y eso es justo lo que se compara.
     *
     * LEER, ella y la administración. Ella, para que la pantalla pueda decir
     * «ya la pediste el día tal» en vez de ofrecer otra vez el botón. Iris,
     * porque es quien tiene que ejecutarla.
     *
     * CERRARLA, SÓLO IRIS, y sólo poniendo la fecha de cuándo lo hizo. Si la
     * pudiera cerrar quien la pidió, la solicitud sería un papel que se firma
     * y se rompe uno mismo.
     *
     * BORRARLA, NADIE. Ni Iris. Una baja ejecutada es el comprobante de que
     * se ejecutó, y es lo que habría que poder enseñar si la persona —o quien
     * vigila esto— preguntara. Se queda con su fecha de petición y su fecha
     * de cumplimiento, y no contiene nada que no se pueda guardar: un uid, un
     * correo y un nombre, que es exactamente lo que hay que conservar para
     * demostrar que se atendió a la persona correcta.
     */
    match /bajas/{uid} {
      allow read: if esAdmin() || (request.auth != null && uid == request.auth.uid);
      allow create: if dentro()
        && uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && !('hecha' in request.resource.data);
      allow update: if esAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hecha']);
      allow delete: if false;
    }

    /* ---------------------------------------------------------------- */

    /* El resto del mundo, cerrado. Incluida la colección `diagnostico`, que
       sólo toca el servidor. Sin esta línea, cualquier colección nueva nacería
       sin regla y Firestore la trataría como cerrada de todas formas — pero
       dejarlo escrito evita que alguien lo dé por supuesto. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
