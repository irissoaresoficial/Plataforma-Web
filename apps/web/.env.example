# ============================================================================
# LAS VARIABLES DE LA WEB
# ============================================================================
# Copia este fichero a `.env.local` para trabajar en tu ordenador, y pega los
# mismos valores en Vercel (Settings → Environment Variables) para producción.


# ---------------------------------------------------------------- LAS RESERVAS

# URL de la aplicación web de Google Apps Script (la que acaba en /exec).
# Se obtiene al implementar google-apps-script/reservas.gs. Ver README.md.
APPS_SCRIPT_URL=

# La misma clave que hayas puesto en CONFIG.SECRET dentro del script.
APPS_SCRIPT_SECRET=


# ---------------------------------------------------------------- LA MEDICIÓN
#
# CUIDADO CON ESTAS DOS. Empiezan por `NEXT_PUBLIC_`, y eso significa que su
# valor se mete DENTRO del código cuando se construye la web, no se lee cada
# vez que alguien entra. Consecuencias, las dos importantes:
#
#   1. Añadirlas en Vercel NO BASTA. Hay que volver a desplegar después, o la
#      web seguirá sirviendo la versión construida sin ellas.
#
#   2. Si faltan, `components/Medicion.tsx` se sale sin pintar nada: ni cartel
#      de cookies, ni píxel, ni etiqueta de Google. La web funciona igual de
#      bien, pero no se mide absolutamente nada y no hay ningún error que
#      avise. Es un fallo silencioso, y por eso está escrito aquí.
#
# Cómo comprobar que funciona: entra en la web, acepta el cartel, y mira en el
# Administrador de eventos de Meta si llega un `PageView`. Si el conjunto de
# datos dice «No se recibió ningún evento», es que una de estas dos cosas
# falla: o la variable no está en Vercel, o no se ha vuelto a desplegar.

# El número del píxel de Meta. Está en Meta → Orígenes de datos →
# Conjuntos de datos, debajo del nombre («Identificador»).
NEXT_PUBLIC_META_PIXEL_ID=

# La etiqueta de Google Analytics, del tipo `G-XXXXXXXXXX`. Opcional: si se
# deja vacía, sólo se carga Meta.
NEXT_PUBLIC_GOOGLE_TAG_ID=
